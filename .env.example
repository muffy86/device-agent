# ─── provider ────────────────────────────────────────────────────────────────
# mock | openai | anthropic | google   (mock needs no key and no network)
DEVICE_AGENT_PROVIDER=mock
DEVICE_AGENT_MODEL=

# any OpenAI-compatible endpoint works here (OpenAI, Groq, OpenRouter, DeepSeek,
# Together, Cerebras, Ollama on 127.0.0.1:11434/v1, llama.cpp, vLLM ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ─── money ───────────────────────────────────────────────────────────────────
# hard ceiling, USD, per principal. The agent stops; it does not ask for more.
DEVICE_AGENT_BUDGET_USD=1.00
# what you charge a customer per 1M tokens (hosted mode only)
BILLING_MARKUP=2.5

# ─── safety ──────────────────────────────────────────────────────────────────
# filesystem root the agent may touch. nothing outside it is readable.
DEVICE_AGENT_ROOT=./.data/workspace
# shell execution is OFF unless you turn it on, and per-call approval still applies
DEVICE_AGENT_ALLOW_SHELL=false
# non-interactive approval for mutating tools (dev only)
DEVICE_AGENT_AUTOAPPROVE=false
# comma-separated host allowlist for http_get. empty = no egress.
DEVICE_AGENT_HTTP_ALLOW=

# ─── server ──────────────────────────────────────────────────────────────────
PORT=8787
# bearer token clients must present. generate one, do not reuse it.
DEVICE_AGENT_TOKEN=
DEVICE_AGENT_DATA=./.data
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
